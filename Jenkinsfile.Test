pipeline {

    agent any

    triggers {
        githubPush()
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
        timeout(time: 20, unit: 'MINUTES')
        buildDiscarder(
            logRotator(
                numToKeepStr: '20',
                artifactNumToKeepStr: '10'
            )
        )
    }

    environment {
        DEPLOY_BASE = '/var/www/SSManagement/TEST'
        DEPLOY_PATH = '/var/www/SSManagement/TEST/Angular'
        PM2_APP     = 'AngularTEST'
        PORT        = '4201'
    }

    stages {

        stage('Checkout') {
            steps {
                echo '======================================'
                echo 'CHECKING OUT REPOSITORY'
                echo '======================================'

                checkout scm
            }
        }

        stage('Validate Environment') {
            steps {
                sh '''#!/bin/bash
                    set -e

                    echo "======================================"
                    echo "VALIDATING ENVIRONMENT"
                    echo "======================================"

                    echo "Node: $(node --version)"
                    echo "NPM : $(npm --version)"

                    echo "Checking deployment base directory..."
                    mkdir -p "$DEPLOY_BASE"

                    echo "Environment validation successful."
                '''
            }
        }

        stage('Install Dependencies') {
            steps {
                echo '======================================'
                echo 'INSTALLING NPM DEPENDENCIES'
                echo '======================================'

                sh '''#!/bin/bash
                    set -e
                    npm install --legacy-peer-deps
                '''
            }
        }

        stage('Build Angular') {
            steps {
                echo '======================================'
                echo 'BUILDING ANGULAR APPLICATION'
                echo '======================================'

                sh '''#!/bin/bash
                    set -e
                    rm -rf dist
                    npm run build -- --configuration=production
                '''
            }
        }

        stage('Validate Build') {
            steps {
                sh '''#!/bin/bash
                    set -e

                    echo "======================================"
                    echo "VALIDATING ANGULAR BUILD"
                    echo "======================================"

                    BUILD_SOURCE=$(find dist -name "index.html" -exec dirname {} \\; | head -n 1)

                    if [ -z "$BUILD_SOURCE" ] || [ ! -d "$BUILD_SOURCE" ]; then
                        echo "ERROR: index.html not found inside dist."
                        find dist -maxdepth 4 -type f || true
                        exit 1
                    fi

                    echo "Compiled output located at: $BUILD_SOURCE"
                    echo "Files built: $(find "$BUILD_SOURCE" -type f | wc -l)"
                '''
            }
        }

        stage('Prepare New Deployment') {
            steps {
                sh '''#!/bin/bash
                    set -e

                    echo "======================================"
                    echo "PREPARING NEW DEPLOYMENT"
                    echo "======================================"

                    TEMP_DIR="$DEPLOY_BASE/Angular_new"
                    rm -rf "$TEMP_DIR"
                    mkdir -p "$TEMP_DIR"

                    BUILD_SOURCE=$(find dist -name "index.html" -exec dirname {} \\; | head -n 1)
                    cp -a "$BUILD_SOURCE"/. "$TEMP_DIR"/

                    if [ ! -f "$TEMP_DIR/index.html" ]; then
                        echo "ERROR: index.html missing from prepared bundle."
                        rm -rf "$TEMP_DIR"
                        exit 1
                    fi

                    echo "Temporary deployment prepared successfully."
                '''
            }
        }

        stage('Backup Current Deployment') {
            steps {
                sh '''#!/bin/bash
                    set -e

                    echo "======================================"
                    echo "BACKING UP CURRENT BUILD"
                    echo "======================================"

                    TARGET_EXISTING=""
                    if [ -d "$DEPLOY_PATH" ] && [ "$(ls -A "$DEPLOY_PATH" 2>/dev/null)" ]; then
                        TARGET_EXISTING="$DEPLOY_PATH"
                    elif [ -d "$DEPLOY_BASE/angular" ] && [ "$(ls -A "$DEPLOY_BASE/angular" 2>/dev/null)" ]; then
                        TARGET_EXISTING="$DEPLOY_BASE/angular"
                    fi

                    if [ -n "$TARGET_EXISTING" ]; then
                        TIMESTAMP=$(date +"%Y%m%d_%H%M%S")
                        BACKUP_PATH="$DEPLOY_BASE/Angular_$TIMESTAMP"

                        echo "Moving existing deployment to: $BACKUP_PATH"
                        mv "$TARGET_EXISTING" "$BACKUP_PATH"
                        echo "$BACKUP_PATH" > "$DEPLOY_BASE/.last_backup"
                        echo "Backup created successfully."
                    else
                        echo "No active deployment found in $DEPLOY_PATH. Skipping backup."
                        rm -f "$DEPLOY_BASE/.last_backup"
                    fi
                '''
            }
        }

        stage('Activate New Deployment') {
            steps {
                sh '''#!/bin/bash
                    set -e

                    echo "======================================"
                    echo "ACTIVATING NEW BUILD"
                    echo "======================================"

                    TEMP_DIR="$DEPLOY_BASE/Angular_new"

                    if [ ! -d "$TEMP_DIR" ] || [ ! -f "$TEMP_DIR/index.html" ]; then
                        echo "ERROR: Valid temporary build not found."
                        exit 1
                    fi

                    mv "$TEMP_DIR" "$DEPLOY_PATH"

                    if [ ! -f "$DEPLOY_PATH/index.html" ]; then
                        echo "ERROR: Active deployment verification failed."
                        exit 1
                    fi

                    echo "New build activated at: $DEPLOY_PATH"
                '''
            }
        }

        stage('Restart Angular PM2') {
            steps {
                sh '''#!/bin/bash
                    set -e

                    echo "======================================"
                    echo "RESTARTING PM2 PROCESS"
                    echo "======================================"

                    if pm2 describe "$PM2_APP" > /dev/null 2>&1; then
                        pm2 restart "$PM2_APP"
                    else
                        echo "PM2 process $PM2_APP not found. Starting instance on port $PORT..."
                        pm2 start npx --name "$PM2_APP" -- http-server "$DEPLOY_PATH" -p "$PORT" -s --spa || pm2 start npx --name "$PM2_APP" -- serve -s "$DEPLOY_PATH" -l "$PORT"
                    fi

                    pm2 save
                    echo "PM2 process $PM2_APP restarted successfully."
                '''
            }
        }

        stage('Verify Deployment') {
            steps {
                sh '''#!/bin/bash
                    set -e

                    echo "======================================"
                    echo "VERIFYING DEPLOYMENT"
                    echo "======================================"

                    if [ ! -f "$DEPLOY_PATH/index.html" ]; then
                        echo "ERROR: index.html not found in $DEPLOY_PATH."
                        exit 1
                    fi

                    echo "PM2 Status:"
                    pm2 status "$PM2_APP"

                    echo ""
                    echo "Checking port $PORT..."
                    PORT_OPEN=false
                    for i in {1..10}; do
                        if ss -lnt | grep -q ":$PORT "; then
                            echo "Port $PORT is listening."
                            PORT_OPEN=true
                            break
                        fi
                        echo "Waiting for port $PORT... ($i/10)"
                        sleep 2
                    done

                    if [ "$PORT_OPEN" != "true" ]; then
                        echo "ERROR: Port $PORT is not listening."
                        exit 1
                    fi

                    echo "Deployment verification completed successfully."
                '''
            }
        }
    }

    post {
        success {
            echo '''
==========================================
UI TEST DEPLOYMENT SUCCESSFUL
==========================================
URL         : http://200.141.4.172:4201
Deploy Path : /var/www/SSManagement/TEST/Angular
Backups     : /var/www/SSManagement/TEST/Angular_YYYYMMDD_HHMMSS
==========================================
'''
        }

        failure {
            echo '''
==========================================
UI DEPLOYMENT FAILED - RESTORING BACKUP
==========================================
'''
            sh '''#!/bin/bash
                set +e
                BACKUP_FILE="$DEPLOY_BASE/.last_backup"

                if [ -f "$BACKUP_FILE" ]; then
                    BACKUP_PATH=$(cat "$BACKUP_FILE")
                    if [ -d "$BACKUP_PATH" ]; then
                        echo "Rolling back to: $BACKUP_PATH"
                        pm2 stop "$PM2_APP" || true
                        rm -rf "$DEPLOY_PATH"
                        mv "$BACKUP_PATH" "$DEPLOY_PATH"
                        pm2 restart "$PM2_APP" || true
                        pm2 save || true
                        echo "Rollback completed."
                    fi
                fi
            '''
        }

        always {
            cleanWs(
                deleteDirs: true,
                disableDeferredWipeout: true,
                notFailBuild: true
            )
        }
    }
}
